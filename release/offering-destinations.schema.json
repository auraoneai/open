{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://auraone.ai/schemas/oss-offering-destinations/v1.json",
  "title": "AuraOne OSS offering and destination inventory",
  "type": "object",
  "required": ["schemaVersion", "offerings"],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": "1.0.0" },
    "offerings": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "offering",
          "targetVersion",
          "releaseScope",
          "owner",
          "evidence",
          "destinations"
        ],
        "properties": {
          "offering": { "type": "string", "minLength": 1 },
          "targetVersion": { "type": "string", "minLength": 1 },
          "releaseScope": { "enum": ["changed", "unchanged"] },
          "owner": { "type": "string", "minLength": 1 },
          "evidence": { "type": "string", "minLength": 1 },
          "destinations": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["id", "label"],
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
                },
                "label": { "type": "string", "minLength": 1 },
                "state": { "enum": ["blocked", "not-applicable"] }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
