{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://auraone.ai/schemas/oss-release-evidence/v1.json",
  "title": "AuraOne OSS release evidence",
  "type": "object",
  "required": [
    "product",
    "version",
    "sourceCommit",
    "releasedAt",
    "license",
    "artifacts",
    "status"
  ],
  "properties": {
    "product": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "minLength": 1 },
    "sourceCommit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "releasedAt": { "type": "string", "format": "date-time" },
    "license": { "type": "string", "minLength": 1 },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "platform",
          "arch",
          "type",
          "url",
          "sha256",
          "signed",
          "verifiedAt"
        ],
        "properties": {
          "platform": { "enum": ["macos", "windows", "linux", "web"] },
          "arch": { "type": "string", "minLength": 1 },
          "type": { "type": "string", "minLength": 1 },
          "url": { "type": "string", "format": "uri" },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "signed": { "type": "boolean" },
          "notarized": { "type": "boolean" },
          "minimumOS": { "type": "string" },
          "verifiedAt": { "type": "string", "format": "date-time" }
        },
        "additionalProperties": false
      }
    },
    "browserPreview": {
      "type": "object",
      "required": ["url", "sourceCommit", "verifiedAt"],
      "properties": {
        "url": { "type": "string", "format": "uri" },
        "sourceCommit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "verifiedAt": { "type": "string", "format": "date-time" }
      },
      "additionalProperties": false
    },
    "securityPolicy": { "type": "string", "format": "uri" },
    "support": { "type": "string" },
    "status": {
      "enum": ["verified", "stale", "partial", "blocked", "unavailable"]
    },
    "blockers": {
      "type": "array",
      "items": { "type": "string" }
    }
  },
  "additionalProperties": false
}
