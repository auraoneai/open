{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://auraone.ai/schemas/oss-publication-requirement-evidence/v1.json",
  "title": "AuraOne OSS live required-publication evidence",
  "type": "object",
  "required": [
    "schemaVersion",
    "releasePlan",
    "requirement",
    "sourceCommits",
    "verifiedAt",
    "verifier",
    "evidenceUris",
    "checks"
  ],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": "1.0.0" },
    "releasePlan": { "type": "string", "minLength": 1 },
    "requirement": { "type": "string", "minLength": 1 },
    "sourceCommits": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[0-9a-f]{40}$" }
    },
    "verifiedAt": { "type": "string", "format": "date-time" },
    "verifier": { "type": "string", "minLength": 1 },
    "evidenceUris": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "format": "uri" }
    },
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "status", "evidence"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "status": { "const": "passed" },
          "evidence": { "type": "string", "minLength": 1 }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
