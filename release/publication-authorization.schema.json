{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://auraone.ai/schemas/oss-publication-authorization/v1.json",
  "title": "AuraOne OSS coordinated publication authorization",
  "type": "object",
  "required": [
    "$schema",
    "schemaVersion",
    "releasePlan",
    "decision",
    "publicationAllowed",
    "authorizedAt",
    "expiresAt",
    "approvers",
    "releases"
  ],
  "properties": {
    "$schema": { "const": "./publication-authorization.schema.json" },
    "schemaVersion": { "const": "1.0.0" },
    "releasePlan": {
      "const": "release(oss): publish Proofline UI/UX upgrade across all channels"
    },
    "decision": { "enum": ["blocked", "approved", "revoked"] },
    "publicationAllowed": { "type": "boolean" },
    "authorizedAt": {
      "type": ["string", "null"],
      "format": "date-time"
    },
    "expiresAt": {
      "type": ["string", "null"],
      "format": "date-time"
    },
    "approvers": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "pattern": "\\S" }
    },
    "releases": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "repository",
          "sourceCommit",
          "package",
          "version",
          "channels"
        ],
        "properties": {
          "repository": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "sourceCommit": {
            "type": "string",
            "pattern": "^[0-9a-f]{40}$"
          },
          "package": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "version": {
            "type": "string",
            "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*))*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$"
          },
          "channels": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            }
          }
        },
        "additionalProperties": false
      }
    },
    "reason": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "decision": { "const": "approved" } },
        "required": ["decision"]
      },
      "then": {
        "properties": {
          "publicationAllowed": { "const": true },
          "authorizedAt": { "type": "string" },
          "expiresAt": { "type": "string" },
          "approvers": { "type": "array", "minItems": 1 },
          "releases": { "type": "array", "minItems": 1 }
        }
      }
    },
    {
      "if": {
        "properties": { "decision": { "const": "blocked" } },
        "required": ["decision"]
      },
      "then": {
        "required": ["reason"],
        "properties": {
          "reason": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "publicationAllowed": { "const": false },
          "authorizedAt": { "type": "null" },
          "expiresAt": { "type": "null" },
          "approvers": { "type": "array", "maxItems": 0 },
          "releases": { "type": "array", "maxItems": 0 }
        }
      }
    },
    {
      "if": {
        "properties": { "decision": { "const": "revoked" } },
        "required": ["decision"]
      },
      "then": {
        "required": ["reason"],
        "properties": {
          "reason": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "publicationAllowed": { "const": false }
        }
      }
    }
  ],
  "additionalProperties": false
}
