        "cd opensource/robotics-reviewkit && python -m pytest -p no:cacheprovider -q tests",
        "cd opensource/robotics-reviewkit/viewer/reviewkit-v2 && npm ci && npm run check",
        "pnpm --dir auraone-website run test:capture:oss",
        "pnpm --dir auraone-website exec vitest run tests/buying-toolkit.test.ts tests/site-route-inventory.contract.test.ts tests/open-docs-slice-contract.test.ts tests/open-route-discovery-metadata.contract.test.ts"
      ]
